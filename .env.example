# IBM watsonx.ai Credentials
IBM_WATSONX_API_KEY=your_ibm_api_key_here
IBM_WATSONX_PROJECT_ID=your_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Watson Discovery (optional — for enterprise corpus ingestion)
WATSON_DISCOVERY_API_KEY=your_discovery_api_key_here
WATSON_DISCOVERY_URL=your_discovery_url_here
WATSON_DISCOVERY_ENV_ID=your_environment_id_here
WATSON_DISCOVERY_COLLECTION_ID=your_collection_id_here

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=legal_corpus

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Legal Corpus Data Path
LEGAL_CORPUS_DIR=./data/legal_corpus
